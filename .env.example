# Copy to backend/.env for local dev. NEVER commit real values — this file is
# tracked in git, so it must contain placeholders only. In production, set these
# in Render's Environment tab (or let the render.yaml Blueprint prompt you).

ENV=dev
CHAT_MODEL=gemini-flash-lite-latest

# Neon -> Dashboard -> Connection string. Paste it verbatim; the app strips the
# query params asyncpg cannot parse.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-char-hex-secret

# Google Cloud Console -> Google Auth Platform -> Clients -> Web application
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# No trailing slash. Locally http://localhost:8000
# On Render https://<your-service>.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# Google AI Studio -> Get API key
GEMINI_API_KEY=your-gemini-api-key
