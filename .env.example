# Copy to .env for local dev. Never commit .env. In production set these in
# Render's Environment tab instead.

ENV=dev

# Neon -> Dashboard -> Connection string. Paste it verbatim; the app strips the
# query params asyncpg cannot parse.
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb

# openssl rand -hex 32
SECRET_KEY=

# Google Cloud Console -> Google Auth Platform -> Clients -> Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# No trailing slash. Locally http://localhost:8000
# On Render https://<your-service>.onrender.com
PUBLIC_BASE_URL=http://localhost:8000
